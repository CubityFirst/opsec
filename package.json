{
  "name": "opsec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf workers types && tsc -b && cf build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/migrate-remote.mjs --if-exists && cf deploy --prebuilt --mode production && node scripts/migrate-remote.mjs",
    "types": "cf workers types",
    "icons": "node scripts/make-icons.mjs",
    "countries": "node scripts/make-countries.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-00000000d1d1 --local --persist-to .cloudflare/state --dir drizzle",
    "db:migrate:remote": "cf d1 migrations apply 86818e80-503b-4c67-970a-39d6ca9ab6e0 --dir drizzle",
    "seed": "node scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "cf workers types && tsc -b --noEmit",
    "build:prod": "cf workers types && tsc -b && cf build --mode prod",
    "deploy:prod": "npm run build:prod && npm run db:migrate:remote && cf deploy --prebuilt --mode prod",
    "ci:build": "npm run build:prod",
    "ci:deploy": "npm run db:migrate:remote && cf deploy --prebuilt --mode prod"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "gifuct-js": "^2.1.2",
    "hono": "^4.13.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.39.0",
    "next-themes": "^0.4.6",
    "openai": "^7.9.0",
    "openid-client": "^6.8.7",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.3",
    "shadcn": "^4.19.1",
    "simple-icons": "^16.29.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ulidx": "^2.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
